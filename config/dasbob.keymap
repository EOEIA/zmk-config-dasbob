#include "keys_cs.h"
#include <dt-bindings/zmk/mouse.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1500  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20    // default: 10

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

&mmv { time-to-max-speed-ms = <600>; };

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
        };
    };

    combos {
        compatible = "zmk,combos";

        capsword {
            bindings = <&caps_word>;
            key-positions = <31 30>;
        };

        caron {
            bindings = <&kp LS(CS_CARON)>;
            key-positions = <20 34>;
        };

        acute {
            bindings = <&kp CS_ACUTE>;
            key-positions = <0 34>;
        };
    };

    macros {
        new_macro: new_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp CS_ACUTE>,
                <&macro_tap>,
                <&kp CS_O>,
                <&macro_release>,
                <&kp LEFT_SHIFT>;

            label = "NEW_MACRO";
        };

        nshackem: UsCarkou {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp CS_ACUTE>,
                <&macro_tap>,
                <&kp CS_N>,
                <&macro_release>,
                <&kp CS_ACUTE>;

            label = "USCARKOU";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // This is a sample keymap intended to be replaced with your own

        layer_0 {
            bindings = <
&kp Q           &kp L         &kp Y                 &kp P        &kp B                 &kp Z    &kp F           &kp O        &kp U         &kp CS_APOS
&hm LEFT_ALT C  &hm LSHIFT R  &hm LCTRL S           &hm LGUI T   &kp G                 &kp M    &hm LEFT_GUI N  &hm LCTRL E  &hm RSHIFT I  &hm LEFT_ALT A
&kp W           &kp J         &kp V                 &kp D        &kp K                 &kp X    &kp H           &kp CS_DOT   &kp CS_COMMA  &mt CS_SEMI CS_MINUS
                              &mt LS(CS_CARON) ESC  &lt 1 SPACE  &mt DELETE BACKSPACE  &kp TAB  &lt 3 CS_ACUTE  &lt 2 ENTER
            >;
        };

        number {
            bindings = <
&kp F1   &kp F2   &kp F3  &kp F4  &kp F5   &kp CS_STAR   &kp CS_N7  &kp CS_N8  &kp CS_N9  &kp CS_COMMA
&kp F6   &kp F7   &kp F8  &kp F9  &kp F10  &kp CS_FSLH   &kp CS_N4  &kp CS_N5  &kp CS_N6  &kp CS_N0
&kp F11  &kp F12  &trans  &trans  &trans   &kp CS_EQUAL  &kp CS_N1  &kp CS_N2  &kp CS_N3  &kp CS_DOT
                  &trans  &trans  &trans   &trans        &trans     &trans
            >;
        };

        symbol {
            bindings = <
&kp CS_QMARK          &kp CS_EXCL           &kp CS_CARET              &kp CS_PIPE         &kp CS_EURO     &kp CS_TILDE      &kp CS_DOLLAR     &kp CS_LESS_THAN  &kp CS_GREATER_THAN  &kp GRAVE
&kp CS_DOUBLE_QUOTES  &kp CS_LEFT_BRACKET   &kp CS_LEFT_PARENTHESIS   &kp CS_LEFT_BRACE   &kp CS_PERCENT  &kp CS_AT         &kp CS_SLASH      &kp CS_ASTERISK   &kp CS_HASH          &kp CS_EQUAL
&kp CS_SINGLE_QUOTE   &kp CS_RIGHT_BRACKET  &kp CS_RIGHT_PARENTHESIS  &kp CS_RIGHT_BRACE  &trans          &kp CS_AMPERSAND  &kp CS_BACKSLASH  &kp CS_PLUS       &kp CS_MINUS         &kp CS_DIVIDE
                                            &trans                    &trans              &trans          &trans            &trans            &trans
            >;
        };

        nav {
            bindings = <
&trans         &kp LS(CS_SZ)  &kp CS_U_RING  &trans  &trans  &trans  &trans    &trans    &trans      &trans
&kp CS_UMLAUT  &trans         &trans         &trans  &trans  &trans  &kp LEFT  &kp DOWN  &kp UP      &kp RIGHT
&trans         &trans         &trans         &trans  &trans  &trans  &kp HOME  &kp END   &caps_word  &trans
                              &trans         &trans  &trans  &trans  &trans    &trans
            >;
        };
    };
};
